#include <windows.h>   // defines DS_*, WS_*, etc.
#include <commctrl.h>  // (optional) if you use common controls
#include "resource.h"

// App icon (used for the EXE and for the tray at runtime)
IDI_APP        ICON "openzfs.ico"
IDI_APP_WARN   ICON "openzfs_warn.ico"
IDI_APP_ERR    ICON "openzfs_err.ico"
IDI_APP_SCRUB  ICON "openzfs_scrub.ico"

// Import
IDD_IMPORT DIALOGEX 0,0,500,330
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "OpenZFS - Import"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_ICON_HDR, "Static", SS_ICON | SS_REALSIZECONTROL,
            7, 7, 32, 32
    LTEXT   "Import ZFS Pool", IDC_TITLE, 47, 11, 350, 18
    CONTROL "", IDC_HDR_SEP, "Static", SS_ETCHEDHORZ, 7, 44, 486, 1
    CONTROL "", IDC_LIST, "SysListView32", WS_TABSTOP | WS_BORDER | WS_VSCROLL | WS_HSCROLL | LVS_REPORT,
            7, 52, 486, 182
    GROUPBOX "Import options", IDC_GRP_OPTIONS, 7, 240, 486, 48
    CONTROL "Force",    IDC_CHK_FORCE,    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16,  254, 60, 10
    CONTROL "Read-only",IDC_CHK_READONLY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 89,  254, 70, 10
    CONTROL "No mount", IDC_CHK_NOMOUNT,  "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 172, 254, 70, 10
    CONTROL "Load crypto keys", IDC_CHK_LOADKEYS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 255, 254, 110, 10
    LTEXT   "", IDC_STATUS, 7, 296, 486, 10
    PUSHBUTTON  "Refresh", IDC_BTN_REFRESH,  300, 310, 60, 14
    DEFPUSHBUTTON "Import", IDC_BTN_IMPORT,  366, 310, 60, 14
    PUSHBUTTON  "Close",   IDC_BTN_CLOSE,    433, 310, 60, 14
END

// Password
IDD_PASSPHRASE DIALOGEX 0, 0, 260, 112
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Unlock dataset"
FONT 9, "Segoe UI"
BEGIN
    CONTROL     "", IDC_ICON_HDR, "Static", SS_ICON | SS_REALSIZECONTROL,
                10, 11, 24, 24
    LTEXT       "Enter passphrase", IDC_TITLE, 42, 12, 208, 16
    CONTROL     "", IDC_HDR_SEP, "Static", SS_ETCHEDHORZ, 10, 40, 240, 1
    EDITTEXT    IDC_EDIT_PASSPHRASE, 10, 50, 240, 14, ES_PASSWORD | ES_AUTOHSCROLL
    CONTROL     "Show", IDC_SHOW, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 70, 60, 10
    DEFPUSHBUTTON "OK", IDOK, 152, 90, 50, 14
    PUSHBUTTON  "Cancel", IDCANCEL, 203, 90, 50, 14
END

// Create Pool
IDD_CREATE_POOL DIALOGEX 0, 0, 500, 340
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "OpenZFS - Create Pool"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_ICON_HDR, "Static", SS_ICON | SS_REALSIZECONTROL,
            7, 7, 32, 32
    LTEXT   "Create ZFS Pool", IDC_TITLE, 47, 11, 350, 18
    CONTROL "", IDC_HDR_SEP, "Static", SS_ETCHEDHORZ, 7, 44, 486, 1

    CONTROL "", IDC_DISKLIST, "SysListView32", WS_TABSTOP | WS_BORDER | WS_VSCROLL | WS_HSCROLL | LVS_REPORT,
            7, 52, 486, 110

    LTEXT   "Topology:", IDC_LBL_TOPOLOGY, 7, 170, 50, 10
    COMBOBOX IDC_CMB_TOPOLOGY, 60, 167, 90, 80, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT   "Pool name:", IDC_LBL_POOLNAME, 160, 170, 55, 10
    EDITTEXT IDC_ED_POOLNAME, 218, 167, 120, 14, ES_AUTOHSCROLL

    GROUPBOX "Properties", IDC_GRP_PROPS, 7, 190, 486, 58
    LTEXT   "Case sensitivity:", IDC_LBL_CASESENS, 16, 204, 80, 10
    COMBOBOX IDC_CMB_CASESENS, 98, 202, 90, 80, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT   "ashift:", IDC_LBL_ASHIFT, 198, 204, 26, 10
    COMBOBOX IDC_CMB_ASHIFT, 226, 202, 50, 60, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT   "Compression:", IDC_LBL_COMPRESS, 288, 204, 56, 10
    COMBOBOX IDC_CMB_COMPRESS, 348, 202, 70, 80, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    CONTROL "Encryption (passphrase)", IDC_CHK_ENCRYPTION, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
            16, 224, 160, 10
    LTEXT   "Compatibility:", IDC_LBL_COMPAT, 190, 226, 58, 10
    COMBOBOX IDC_CMB_COMPAT, 250, 224, 130, 100, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL

    LTEXT   "Extra properties, one per line (e.g. dedup=on, net.lundman:llink=on):",
            IDC_LBL_PROPSHINT, 7, 252, 480, 10
    EDITTEXT IDC_ED_PROPS, 7, 264, 486, 40, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP

    CONTROL "I understand this erases the selected disk(s)", IDC_CHK_CONFIRM_ERASE, "Button",
            BS_AUTOCHECKBOX | WS_TABSTOP, 7, 308, 320, 10

    LTEXT   "", IDC_STATUS_CREATE, 7, 322, 340, 10
    DEFPUSHBUTTON "Create", IDC_BTN_CREATE, 366, 318, 60, 14
    PUSHBUTTON  "Cancel", IDC_BTN_CANCEL_CREATE, 433, 318, 60, 14
END

// Destroy Pool confirmation
IDD_CONFIRM_DESTROY DIALOGEX 0, 0, 280, 130
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "OpenZFS - Destroy Pool"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_ICON_HDR, "Static", SS_ICON | SS_REALSIZECONTROL,
            10, 11, 24, 24
    LTEXT   "Destroy pool", IDC_TITLE, 42, 12, 228, 16
    CONTROL "", IDC_HDR_SEP, "Static", SS_ETCHEDHORZ, 10, 40, 260, 1

    LTEXT   "", IDC_LBL_CONFIRM_HINT, 10, 50, 260, 24
    EDITTEXT IDC_ED_CONFIRM_NAME, 10, 76, 260, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON "Destroy", IDOK, 172, 106, 50, 14
    PUSHBUTTON  "Cancel", IDCANCEL, 223, 106, 50, 14
END

